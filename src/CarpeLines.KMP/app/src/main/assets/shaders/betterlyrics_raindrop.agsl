// Ported from BetterLyrics' Shaders/RaindropEffect.cs (WinUI 3 / ComputeSharp), itself ported from
// https://www.shadertoy.com/view/ltffzl. Credit to the original author.
//
// The HLSL is translated statement by statement. Two mechanical differences:
//  * SkSL has no implicit matrix constructors, so the two `Hlsl.Mul` with the orthonormal map are
//    spelled out as dot products (the map is not symmetric: `M * v` and `v * M` differ).
//  * `Hlsl.Max`/`Lerp` are written with explicit vector arguments where HLSL broadcasts a scalar.
// `mod()` replaces HLSL's `%`; every operand there is non-negative, so the two agree.

uniform float2 uResolution;      // effect size in pixels, the D2D dispatch size
uniform float uTime;             // seconds since the page opened, the renderer's accumulator
uniform float uSpeed;            // RaindropSpeed / 100
uniform float uSize;             // RaindropSize / 100
uniform float uDensity;          // RaindropDensity / 100
uniform float uLightAngle;       // RaindropLightAngle in radians
uniform float uShadowIntensity;  // RaindropShadowIntensity / 100

const float RANDOM_SEED = 4.3315;
const float PI = 3.141592653;
const float EPSILON = 1e-6;

// HLSL's smoothstep formula, which also works for edge0 > edge1 (several calls rely on that).
float sstep(float edge0, float edge1, float x) {
    float t = clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0);
    return t * t * (3.0 - 2.0 * t);
}

// `_orthonormalMap * v`
float3 toNoiseSpace(float3 v) {
    return float3(
        dot(v, float3(0.788675134594813, -0.211324865405187, -0.577350269189626)),
        dot(v, float3(-0.211324865405187, 0.788675134594813, -0.577350269189626)),
        dot(v, float3(0.577350269189626, 0.577350269189626, 0.577350269189626)));
}

// `v * _orthonormalMap`
float3 fromNoiseSpace(float3 v) {
    return float3(
        dot(v, float3(0.788675134594813, -0.211324865405187, 0.577350269189626)),
        dot(v, float3(-0.211324865405187, 0.788675134594813, 0.577350269189626)),
        dot(v, float3(-0.577350269189626, -0.577350269189626, 0.577350269189626)));
}

float4 permute(float4 t) {
    return t * (t * 34.0 + 133.0);
}

float3 grad(float hash) {
    float3 cube = mod(floor(hash / float3(1.0, 2.0, 4.0)), 2.0) * 2.0 - 1.0;
    float3 cuboct = cube;
    int index = int(hash / 16.0);
    if (index == 0) {
        cuboct.x = 0.0;
    } else if (index == 1) {
        cuboct.y = 0.0;
    } else {
        cuboct.z = 0.0;
    }
    float gradType = mod(floor(hash / 8.0), 2.0);
    float3 rhomb = (1.0 - gradType) * cube + gradType * (cuboct + cross(cube, cuboct));
    float3 g = cuboct * 1.22474487139 + rhomb;
    g *= (1.0 - 0.042942436724648037 * gradType) * 3.5946317686139184;
    return g;
}

float4 noiseWithDerivativesPart(float3 x) {
    float3 b = floor(x);
    float4 i4 = float4(x - b, 2.5);
    float3 v1 = b + floor(dot(i4, float4(0.25)));
    float3 v2 = b + float3(1.0, 0.0, 0.0) + float3(-1.0, 1.0, 1.0) *
        floor(dot(i4, float4(-0.25, 0.25, 0.25, 0.35)));
    float3 v3 = b + float3(0.0, 1.0, 0.0) + float3(1.0, -1.0, 1.0) *
        floor(dot(i4, float4(0.25, -0.25, 0.25, 0.35)));
    float3 v4 = b + float3(0.0, 0.0, 1.0) + float3(1.0, 1.0, -1.0) *
        floor(dot(i4, float4(0.25, 0.25, -0.25, 0.35)));
    float4 hashes = permute(mod(float4(v1.x, v2.x, v3.x, v4.x), 289.0));
    hashes = permute(hashes + mod(float4(v1.y, v2.y, v3.y, v4.y), 289.0));
    hashes = mod(permute(hashes + mod(float4(v1.z, v2.z, v3.z, v4.z), 289.0)), 48.0);
    float3 d1 = x - v1;
    float3 d2 = x - v2;
    float3 d3 = x - v3;
    float3 d4 = x - v4;
    float4 a = max(
        0.75 - float4(dot(d1, d1), dot(d2, d2), dot(d3, d3), dot(d4, d4)),
        float4(0.0));
    float4 aa = a * a;
    float4 aaaa = aa * aa;
    float3 g1 = grad(hashes.x);
    float3 g2 = grad(hashes.y);
    float3 g3 = grad(hashes.z);
    float3 g4 = grad(hashes.w);
    float4 extrapolations = float4(
        dot(d1, g1), dot(d2, g2), dot(d3, g3), dot(d4, g4));
    // Hlsl.Mul(float3x4 rows, vector) is a weighted sum of the four gradient vectors.
    float4 weights = aa * a * extrapolations;
    float3 derivative =
        -8.0 * (d1 * weights.x + d2 * weights.y + d3 * weights.z + d4 * weights.w) +
        (g1 * aaaa.x + g2 * aaaa.y + g3 * aaaa.z + g4 * aaaa.w);
    return float4(derivative, dot(aaaa, extrapolations));
}

float4 noiseWithDerivatives(float3 x) {
    x = toNoiseSpace(x);
    float4 result = noiseWithDerivativesPart(x) + noiseWithDerivativesPart(x + 144.5);
    return float4(fromNoiseSpace(result.xyz), result.w);
}

float gradientWave(float b, float t) {
    return sstep(0.0, b, t) * sstep(1.0, b, t);
}

float random1(float2 uv) {
    return fract(sin(dot(uv * 13.235, float2(12.9898, 78.233)) * 0.000001) * 43758.5453123 *
                 RANDOM_SEED);
}

float3 randomVec3(float2 uv) {
    return float3(random1(uv), random1(uv * 2.0), random1(uv * 3.0));
}

float mapToRange(float edge0, float edge1, float x) {
    return clamp((x - edge0) / (edge1 - edge0), 0.0, 1.0);
}

float proportionalMapToRange(float edge0, float edge1, float x) {
    return edge0 + (edge1 - edge0) * x;
}

// A safety net for GLSL's undefined normalize(0) - HLSL returns a zero vector there, which the
// acos() below turns into a well-defined angle. Without it the drop would carry a NaN.
float2 safeNormalize(float2 v) {
    return v / max(length(v), EPSILON);
}

float3 raindropSurface(float2 xy, float distanceScale, float zScale) {
    float a = distanceScale;
    float x = xy.x;
    float y = xy.y;
    float n = 1.5;
    float m = 0.5;
    float s = zScale;
    float tempZ = 1.0 - pow(x / a, 2.0) - pow(y / a, 2.0);
    float z = pow(max(0.0, tempZ), a / 2.0);
    float zInMAndN = (z - m) / (n - m);
    float t = min(max(zInMAndN, 0.0), 1.0);
    float height = s * t * t * (3.0 - 2.0 * t);
    float part01 = s * (6.0 * t - 8.0 * t * t);
    float part02 = 1.0 / (n - m);
    float part03 = -1.0 / a * pow(max(0.0, tempZ), a / 2.0 - 1.0);
    float tempValue = zInMAndN > 0.0 && zInMAndN < 1.0 ? part01 * part02 : 0.0;
    float2 partialDerivative = height > 0.0
        ? float2(tempValue * (x * part03), tempValue * (y * part03))
        : float2(0.0);
    return float3(height, partialDerivative);
}

float3 staticRaindrops(float2 uv, float time, float uvScale) {
    float2 tempUv = uv * uvScale;
    float2 id = floor(tempUv);
    float3 randomValue = randomVec3(float2(id.x * 470.15, id.y * 653.58));
    tempUv = fract(tempUv) - 0.5;
    float2 randomPoint = (randomValue.xy - 0.5) * 0.25;
    float2 xy = randomPoint - tempUv;
    float distanceToDrop = length(tempUv - randomPoint);

    float3 noiseInput = float3(tempUv.x * 305.0 * 0.02, tempUv.y * 305.0 * 0.02, 1.8660254037844386);
    float4 noiseResult = noiseWithDerivatives(noiseInput);
    float edgeRandomCurveAdjust = noiseResult.w * mix(0.02, 0.175, fract(randomValue.x));

    distanceToDrop = edgeRandomCurveAdjust * 0.5 + distanceToDrop;
    distanceToDrop = distanceToDrop * clamp(mix(1.0, 55.0, randomPoint.x), 1.0, 3.0);
    float gradientFade = gradientWave(0.0005, fract(time * 0.02 + randomValue.z));
    float distanceMaxRange = 1.45 * gradientFade;
    float2 direction = tempUv - randomPoint;

    float theta = PI - acos(clamp(dot(safeNormalize(direction), float2(0.0, 1.0)), -1.0, 1.0));
    theta = theta * randomValue.z;
    float distanceScale = 0.2 / (1.0 - 0.8 * cos(theta - PI / 2.0 - 1.6));
    float yDistance = length(float2(0.0, tempUv.y) - float2(0.0, randomPoint.y));

    float scale = 1.65 * (0.2 + distanceScale) * distanceMaxRange * mix(1.5, 0.5, randomValue.x);
    float2 tempXy = float2(xy.x, xy.y) * 4.0;
    float randomScale = proportionalMapToRange(0.85, 1.35, randomValue.z);
    tempXy.x = randomScale * mix(
        tempXy.x,
        tempXy.x / sstep(1.0, 0.4, yDistance * randomValue.z),
        sstep(1.0, 0.0, randomValue.x));
    tempXy = tempXy + edgeRandomCurveAdjust * 1.0;
    float3 heightAndNormal = raindropSurface(tempXy, scale, 1.0);
    heightAndNormal = float3(heightAndNormal.x, -heightAndNormal.y, -heightAndNormal.z);

    float visible = fract(randomValue.z * 10.0 * RANDOM_SEED) < uDensity ? 1.0 : 0.0;
    heightAndNormal = float3(
        heightAndNormal.x,
        heightAndNormal.y * visible,
        heightAndNormal.z * visible);
    heightAndNormal.x = sstep(0.0, 1.0, heightAndNormal.x) * visible;

    return heightAndNormal;
}

float4 rollingRaindrops(float2 uv, float time, float uvScale) {
    float2 localUv = uv * uvScale;
    float2 tempUv = localUv;
    float2 constantA = float2(6.0, 1.0);
    float2 gridNum = constantA * 2.0;
    float2 gridId = floor(localUv * gridNum);

    float randomFloat = random1(float2(gridId.x * 131.26, gridId.x * 101.81));
    float timeMovingY = time * 0.85 * proportionalMapToRange(0.1, 0.25, randomFloat);
    localUv.y += timeMovingY + randomFloat;

    float2 scaledUv = localUv * gridNum;
    gridId = floor(scaledUv);
    float3 randomVec = randomVec3(float2(gridId.x * 17.32, gridId.y * 2217.54));
    float2 gridUv = fract(scaledUv) - float2(0.5, 0.0);

    float swingX = randomVec.x - 0.5;
    float swingY = tempUv.y * 20.0;
    float swingPosition = sin(swingY + sin(gridId.y * randomVec.z + swingY) + gridId.y * randomVec.z);
    swingX += swingPosition * (0.5 - abs(swingX)) * (randomVec.z - 0.5);
    swingX *= 0.65;
    float randomNormalizedTime = fract(timeMovingY + randomVec.z);
    swingY = clamp((gradientWave(0.87, randomNormalizedTime) - 0.5) * 0.9 + 0.5, 0.15, 0.85);
    float2 position = float2(swingX, swingY);

    float2 xy = position - gridUv;
    float2 direction = (gridUv - position) * constantA.yx;
    float distanceToDrop = length(direction);

    float3 noiseInput = float3(tempUv.x * 513.20 * 0.02, tempUv.y * 779.40 * 0.02, 2.1660251037743386);
    float4 noiseResult = noiseWithDerivatives(noiseInput);
    float edgeRandomCurveAdjust = noiseResult.w * mix(0.02, 0.175, fract(randomVec.y));

    distanceToDrop = edgeRandomCurveAdjust + distanceToDrop;
    float theta = PI - acos(clamp(dot(safeNormalize(direction), float2(0.0, 1.0)), -1.0, 1.0));
    theta = theta * randomVec.z;
    float distanceScale = 0.2 / (1.0 - 0.8 * cos(theta - PI / 2.0 - 1.6));
    float scale = 1.65 * (0.2 + distanceScale) * 1.45 * mix(1.0, 0.25, randomVec.x);
    float2 tempXy = float2(xy.x, xy.y) * 4.0;
    tempXy = tempXy * float2(1.0, 4.2) + edgeRandomCurveAdjust * 0.85;
    float3 heightAndNormal = raindropSurface(tempXy, scale, 1.0);

    float trailY = pow(sstep(1.0, swingY, gridUv.y), 0.5);
    float trailX = abs(gridUv.x - swingX) * mix(0.8, 4.0, sstep(0.0, 1.0, randomVec.x));
    float trail = sstep(0.25 * trailY, 0.15 * trailY * trailY, trailX);
    float trailClamp = sstep(-0.02, 0.02, gridUv.y - swingY);
    trail *= trailClamp * trailY;

    float signOfTrailX = sign(gridUv.x - swingX);
    float3 trailNoiseInput = float3(
        tempUv.x * 513.20 * 0.02 * signOfTrailX, tempUv.y * 779.40 * 0.02, 2.1660251037743386);
    float4 trailNoiseResult = noiseWithDerivatives(trailNoiseInput);
    float trailEdgeRandomCurveAdjust =
        trailNoiseResult.w * mix(0.002, 0.175, fract(randomVec.y));
    float trailXDistance = mapToRange(0.0, 0.1, trailEdgeRandomCurveAdjust * 0.5 + trailX);
    float2 trailDirection =
        signOfTrailX * float2(1.0, 0.0) + float2(0.0, 1.0) * sstep(1.0, 0.0, trail) * 0.5;
    float2 trailXy = trailDirection * trailXDistance;

    float3 trailHeightAndNormal = raindropSurface(trailXy, 1.0, 1.0);
    trailHeightAndNormal = trailHeightAndNormal * pow(trail * randomVec.y, 2.0);
    trailHeightAndNormal.x = sstep(0.0, 1.0, trailHeightAndNormal.x);

    swingY = tempUv.y;
    float remainTrail = sstep(0.2 * trailY, 0.0, trailX);
    float remainDroplet =
        max(0.0, sin(swingY * (1.0 - swingY) * 120.0) - gridUv.y) * remainTrail *
        trailClamp * randomVec.z;
    swingY = fract(swingY * 10.0) + (gridUv.y - 0.5);
    float2 remainDropletXy = gridUv - float2(swingX, swingY);
    remainDropletXy = remainDropletXy * float2(1.2, 0.8) + edgeRandomCurveAdjust * 0.85;
    float3 remainDropletHeightAndNormal = raindropSurface(remainDropletXy, 2.0 * remainDroplet, 1.0);
    remainDropletHeightAndNormal.x = sstep(0.0, 1.0, remainDropletHeightAndNormal.x);
    remainDropletHeightAndNormal = trailHeightAndNormal.x > 0.0
        ? float3(0.0)
        : remainDropletHeightAndNormal;

    float4 returnValue = float4(
        heightAndNormal.x + trailHeightAndNormal.x * trailY * trailClamp +
            remainDropletHeightAndNormal.x * trailY * trailClamp,
        heightAndNormal.yz + trailHeightAndNormal.yz + remainDropletHeightAndNormal.yz,
        trail);

    float visible = fract(randomVec.z * 20.0 * RANDOM_SEED) < uDensity ? 1.0 : 0.0;
    returnValue *= visible;
    return returnValue;
}

float4 raindrops(float2 uv, float time, float staticScale, float rollingScale) {
    float3 staticRaindrop = staticRaindrops(uv, time, staticScale);
    float4 rollingRaindrop = rollingRaindrops(uv, time, rollingScale);
    return float4(
        staticRaindrop.x + rollingRaindrop.x,
        staticRaindrop.yz + rollingRaindrop.yz,
        rollingRaindrop.w);
}

half4 main(float2 fragCoord) {
    // The D2D shader flips the scene position, because Direct2D counts y upwards.
    float2 scenePos = float2(fragCoord.x, uResolution.y - fragCoord.y);
    float2 localUv = (scenePos - 0.5 * uResolution) / uResolution.y;

    float staticUvScale = 20.0 / max(0.1, uSize);
    float rollingUvScale = 2.25 / max(0.1, uSize);

    float4 raindrop = raindrops(localUv, uTime * uSpeed, staticUvScale, rollingUvScale);

    float height = raindrop.x;
    float2 normal = raindrop.yz;

    float dropMask = sstep(0.02, 0.15, height);

    float lightX = cos(uLightAngle);
    float lightY = sin(uLightAngle);
    float3 lightDir = normalize(float3(lightX, lightY, 1.5));

    float3 surfaceNormal = normalize(float3(normal.x, normal.y, 1.0 - height));

    float specular = pow(max(0.0, dot(surfaceNormal, lightDir)), 24.0);
    float edgeShadow = sstep(0.2, 1.0, length(normal)) * uShadowIntensity;

    float baseBrightness = clamp(0.15 * height + specular - edgeShadow, 0.0, 1.0);
    float alpha = dropMask * clamp(0.25 + specular, 0.0, 1.0);

    return half4(baseBrightness, baseBrightness, baseBrightness, alpha);
}
