<?xml version="1.0" encoding="utf-8"?>
<!--
  CarpeLines launcher background — 108dp adaptive-icon canvas, full bleed.
  The launcher applies its own mask (squircle / circle / rounded square), so this
  layer must not round its own corners.

  Brand: a warm paper gradient running from light apricot to amber. It is the only
  coloured surface the mark ever sits on; there is no dark variant. Keep it a single
  hue — mixing in a second hue (even faintly) turns the middle of the ramp into a
  grey caramel that reads as dirty. See logo/README.md at the repository root.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

        <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FFFFF6EA" />
                <item android:offset="1" android:color="#FFFFE4C6" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
