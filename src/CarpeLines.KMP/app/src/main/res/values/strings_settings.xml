    <string name="settings_category_player_filter_title">Player Filter</string>
    <string name="settings_category_player_filter_subtitle">Choose which players CarpeLines follows</string>
    <string name="player_filter_intro">When the filter is on, CarpeLines follows only the players you select. Their media sessions drive the lyrics screen and listening statistics; playback from every other app is ignored.</string>
    <string name="player_filter_enabled_title">Enable player filter</string>
    <string name="player_filter_enabled_subtitle_on">Only the selected players are followed; other playback is ignored.</string>
    <string name="player_filter_enabled_subtitle_off">Every player that publishes a media session is followed.</string>
    <string name="player_filter_reset_title">Allow all players</string>
    <string name="player_filter_reset_subtitle">Turn the filter off and follow every player again.</string>
    <string name="player_filter_detected_header">Detected players</string>
    <string name="player_filter_empty_title">No players detected yet</string>
    <string name="player_filter_empty_subtitle">Start playback in any music app; it will show up here.</string>
    <string name="player_filter_none_selected_notice">The filter is on, but no player is selected, so no media session will be followed.</string>
    <string name="player_filter_unknown_notice">Ignored players reappear here the next time they publish a media session, so you can switch them on.</string>
